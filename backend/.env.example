# Application settings
# Set to 'true' for development (enables safe defaults)
# Set to 'false' for production (requires all secrets to be set)
DEBUG=true

# Generate a secure random string (32+ characters) for production
# In DEBUG=true mode, "dev-secret-key-32-characters-long-for-local-dev" is used
SECRET_KEY=

# CORS settings - Comma-separated origins for production
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# File storage
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_FILE_SIZE=104857600  # 100MB

# Job settings
JOB_TIMEOUT=3600  # 1 hour
MAX_CONCURRENT_JOBS=5

# OpenAI settings (REQUIRED in production)
# In DEBUG=true mode, "debug-placeholder-key-invalid-for-production" is used
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06
OPENAI_TEMPERATURE=0.6

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 Google (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis (for job queue) - Optional in development
REDIS_URL=redis://localhost:6379

# Database URL (SQLite default for development)
DATABASE_URL=sqlite:///./translation_pipeline.db

# Feature flags
ENABLE_STYLE_CHECKING=true
ENABLE_EXPANSION_POLICY=true
ENABLE_FORMATTING_PROFILE=true