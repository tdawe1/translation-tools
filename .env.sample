# Copy this file to .env and fill in your actual values
# Never commit your real .env file to version control

# --- OpenAI API Configuration ---
# Required for translation functionality
OPENAI_API_KEY=your_openai_api_key_here

# Optional OpenAI settings
OPENAI_MODEL=gpt-4o-2024-08-06
OPENAI_BASE_URL=
OPENAI_TEMPERATURE=0.6

# --- PDF Translation Dependencies ---
# Make sure you have the required PDF processing libraries installed:
# pip install -r requirements_pdf.txt

# --- Testing Configuration ---
# For running tests in offline mode (no API calls)
TEST_MODE=offline

# --- Cache Configuration ---
# Translation cache file location
CACHE_FILE=translation_cache.json

# --- Glossary Configuration ---
# Custom glossary file for consistent terminology
GLOSSARY_FILE=glossary.json

# --- Feature Flags ---
# Enable/disable specific features
ENABLE_STYLE_CHECKING=1
ENABLE_EXPANSION_POLICY=1
ENABLE_FORMATTING_PROFILE=1
ENABLE_STYLE_AUDIT=1

# --- Style Configuration ---
STYLE_PRESET=gengo
STYLE_GUIDE_FILE=

# --- Google Drive Integration (Optional) ---
# For uploading translated documents to Google Drive
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# OR use Service Account authentication
GDRIVE_SA_JSON=

# Target folder for uploads
GDRIVE_FOLDER_NAME=translation
UPLOAD_FOLDER_ID=
FOLDER_ID=