# Copy to .env and fill in your values

# OpenAI API key (required for translation)
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: Override default model
OPENAI_MODEL=gpt-4o-2024-08-06

# Optional: Custom glossary file
GLOSSARY_FILE=glossary.json

# Optional: Custom cache file
CACHE_FILE=translation_cache.json

# PDF translation options
PDF_DEFAULT_MODEL=gpt-4o-2024-08-06
PDF_BATCH_SIZE=10
PDF_TEMPERATURE=0.6

# Feature flags
ENABLE_STYLE_CHECKING=1
ENABLE_EXPANSION_POLICY=1
ENABLE_FORMATTING_PROFILE=1
ENABLE_STYLE_AUDIT=1

# Style configuration
STYLE_PRESET=gengo