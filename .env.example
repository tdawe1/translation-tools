# Copy to `.env` and fill in values. Never commit your real `.env`.

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key
# Optional overrides
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=
OPENAI_TEMPERATURE=0.6
OPENAI_USE_RESPONSES=1
OPENAI_REASONING_EFFORT=high

# Feature flags ("1" to enable)
ENABLE_STYLE_CHECKING=1
ENABLE_EXPANSION_POLICY=1
ENABLE_FORMATTING_PROFILE=1
ENABLE_STYLE_AUDIT=1

# Style config
STYLE_PRESET=gengo
# Optional path to a local Markdown style guide
STYLE_GUIDE_FILE=

# --- Google Drive upload (choose ONE auth method) ---
# 1) OAuth Client (uploads under a user account)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# 2) Service Account (set one of the two)
# GDRIVE_SA_JSON can be a file path or the raw JSON string
GDRIVE_SA_JSON=

# Target folder
GDRIVE_FOLDER_NAME=translation
# Or specify an explicit folder id to upload into
UPLOAD_FOLDER_ID=
FOLDER_ID=
